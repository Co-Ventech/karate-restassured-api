<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.agency.qa</groupId>
  <artifactId>karate-restassured-api</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Karate and Rest Assured API</name>
  <description>Standalone API suite: Karate and Rest Assured against the same Toolshop API.</description>

  <modules>
    <module>karate</module>
    <module>rest-assured</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <karate.version>1.5.1</karate.version>
    <rest-assured.version>5.5.1</rest-assured.version>
    <junit.version>5.11.4</junit.version>
    <cucumber.reporting.version>5.8.4</cucumber.reporting.version>
    <extentreports.version>5.1.2</extentreports.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
